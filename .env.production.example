# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" on the VPS (next to docker-compose.yml)
# and fill in real values.  cp .env.production.example .env
# ─────────────────────────────────────────────────────────────

# Postgres password (the DB container and the app both use this).
# Use a long random value.
POSTGRES_PASSWORD=CHANGE_ME_long_random_db_password

# NextAuth secret — REQUIRED in production. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_run_openssl_rand_base64_32

# Public URL of the site (used by NextAuth + canonical links).
NEXTAUTH_URL=https://vps.shola.ly
NEXT_PUBLIC_SITE_URL=https://vps.shola.ly

# ── Optional: AI advisor (leave blank to use the offline fallback) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Optional analytics (embedded at build time) ──
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
